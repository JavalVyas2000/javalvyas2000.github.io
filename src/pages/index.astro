---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { site } from "../data/site";
const categories = [
  "AI systems · Control",
  "Multimodal AI · Graphs",
  "Research software · Optimization",
  "Mathematical modelling · Energy",
];
---

<BaseLayout title={site.name + " — " + site.title} description={site.tagline} canonicalPath="/">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span>
        {site.title}
        <span>/</span>
        {site.location}
      </p>
      <h1 id="hero-title">
        {site.name}<span>From complex systems<br />to <em>better decisions.</em></span>
      </h1>
      <p class="hero-description">{site.tagline}</p>
      <div class="actions">
        <a class="button button-primary" href="#projects"
          >Explore my work <span aria-hidden="true">↗</span></a
        >
        <a class="button" href="/resume.pdf">View résumé <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-socials" aria-label="Professional profiles">
        {
          site.socials
            .filter((s) => s.icon !== "medium")
            .map((s) => (
              <a href={s.href}>
                <>
                  <SocialIcon kind={s.icon} />
                  <span>{s.label}</span>
                  <span aria-hidden="true">↗</span>
                </>
              </a>
            ))
        }
      </div>
    </div>
    <figure class="portrait">
      {
        site.avatar && (
          <img
            src={site.avatar}
            alt={"Portrait of " + site.name}
            width="1500"
            height="1800"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
      <figcaption>
        <span>Research. Build. Validate.</span><span aria-hidden="true">↗</span>
      </figcaption>
    </figure>
  </section>
  <div class="focus-strip" aria-label="Research focus">
    <span class="eyebrow">At the intersection of</span><span>Machine learning</span><span
      aria-hidden="true">+</span
    ><span>Mathematical optimization</span><span aria-hidden="true">+</span><span
      >Research engineering</span
    >
  </div>
  <section id="projects" class="content-section" aria-labelledby="projects-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / Selected work</p><h2 id="projects-title">Ideas, implemented.</h2>
      </div>
      <p>Research systems and open-source tools.<br />From the underlying model to working code.</p>
    </div>
    <div class="project-grid">
      {
        site.projects.map((project, index) => (
          <article class:list={["project", { "project-featured": index === 0 }]}>
            <div class="project-topline">
              <>
                <span class="eyebrow">{categories[index]}</span>
                <span class="project-number">0{index + 1}</span>
              </>
            </div>
            <h3>
              <a href={project.href ?? project.repo}>
                {project.title}
                <span aria-hidden="true">↗</span>
              </a>
            </h3>
            <p class="project-description">{project.blurb}</p>
            <ul class="project-highlights">
              {project.highlights?.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <div class="tags">
              {project.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
            <div class="project-links">
              {project.href && (
                <a href={project.href}>
                  Read paper <span aria-hidden="true">↗</span>
                </a>
              )}
              {project.repo && (
                <a href={project.repo}>
                  View code <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>
  <section id="research" class="content-section" aria-labelledby="research-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / Publications</p><h2 id="research-title">Research in the open.</h2>
      </div>
      <a class="text-link" href={site.scholarUrl}
        >Full Google Scholar profile <span aria-hidden="true">↗</span></a
      >
    </div>
    <ol class="publications">
      {
        site.publications?.map((paper) => (
          <li class="publication">
            <span class="publication-year">{paper.year}</span>
            <div>
              <>
                <h3>
                  <a href={paper.href ?? site.scholarUrl}>{paper.title}</a>
                </h3>
                <p>
                  {paper.venue}
                  <span aria-hidden="true"> · </span>
                  <span class="publication-type">{paper.note}</span>
                </p>
              </>
            </div>
            <a
              class="paper-arrow"
              href={paper.href ?? site.scholarUrl}
              aria-label={"Read " + paper.title}
            >
              ↗
            </a>
          </li>
        ))
      }
    </ol>
  </section>
  <section id="about" class="content-section about-section" aria-labelledby="about-title">
    <div class="about-copy">
      <p class="eyebrow">03 / Approach & expertise</p><h2 id="about-title">
        Rigorous models.<br />Useful software.
      </h2>
      <p>
        I work on decision-making under constraints: how to model a complex system, learn from its
        data, and check whether a proposed action will actually work.
      </p>
      <p>
        My projects span process control, energy systems, and scheduling. I’m interested in bringing
        this combination of mathematical modelling and hands-on engineering to AI and quantitative
        research roles.
      </p>
      <a class="text-link" href="/resume.pdf"
        >Explore my background <span aria-hidden="true">↗</span></a
      >
    </div>
    <div id="skills" class="skills-list">
      {
        site.skills.map((skill, index) => (
          <div class="skill-row">
            <>
              <span class="skill-number">0{index + 1}</span>
              <div>
                <>
                  <h3>{skill.group}</h3>
                  <p>{skill.items.join(" · ")}</p>
                </>
              </div>
            </>
          </div>
        ))
      }
    </div>
  </section>
  <section id="contact" class="contact-section" aria-labelledby="contact-title">
    <div>
      <p class="eyebrow">04 / Get in touch</p><h2 id="contact-title">
        Let’s solve something<br /><em>interesting.</em>
      </h2><p>For opportunities in AI, quantitative research, and research engineering.</p>
    </div>
    <div class="contact-links">
      <a class="contact-email" href={"mailto:" + site.email}
        >{site.email}<span aria-hidden="true">↗</span></a
      >
      <div class="contact-socials">
        {
          site.socials.map((social) => (
            <a href={social.href}>
              {social.label} <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
