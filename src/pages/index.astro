---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title={site.name + " — " + site.title} description={site.tagline} canonicalPath="/">
  <section class="hero" aria-labelledby="hero-title">
    <div class="page-kicker">
      <span>RESEARCH / ENGINEERING</span><span>IMPERIAL COLLEGE LONDON</span>
    </div>
    <h1 id="hero-title">
      {site.name}<span>Optimization &<br />machine learning<span class="blue-period">.</span></span>
    </h1>
    <div class="hero-bottom">
      <p>{site.tagline}</p>
      <div class="hero-meta">
        <span>PhD · Chemical Engineering</span><span>Sep 2024 — Dec 2027 (expected)</span><a
          href={site.scholarUrl}>Google Scholar ↗</a>
        <a href="/resume.pdf">Curriculum vitae ↗</a>
      </div>
    </div>
    <p class="research-interests">
      Research interests <span>Quantitative research / Development / AI</span>
    </p>
  </section>

  <section id="projects" class="content-section" aria-labelledby="projects-title">
    <div class="section-heading">
      <h2 id="projects-title"><span>01</span> Selected work</h2><span class="section-meta"
        >MODELS → METHODS → SOFTWARE</span>
    </div>
    <div class="project-list">
      {
        site.projects.map((project, index) => (
          <article class:list={["project", { "project-featured": index === 0 }]}>
            <div class="project-index">{String(index + 1).padStart(2, "0")}</div>
            <div class="project-body">
              <p class="eyebrow">{project.category}</p>
              <h3>
                <a href={project.href ?? project.repo}>{project.title}</a>
              </h3>
              <p class="project-description">{project.blurb}</p>
              {index === 0 && (
                <div class="result-strip" aria-label="SP3120 Tight formulation results">
                  <div>
                    <strong>
                      4×<span> max.</span>
                    </strong>
                    <span>COMPUTATIONAL SPEEDUP</span>
                  </div>
                  <div>
                    <strong>
                      0.18%<span> median</span>
                    </strong>
                    <span>OBJECTIVE DEVIATION</span>
                  </div>
                  <p>
                    SP3120 · Tight formulation
                    <br />
                    Separate benchmark statistics.
                    <br />
                    <a href="https://arxiv.org/pdf/2607.19570">Method & results, Table 3 ↗</a>
                  </p>
                </div>
              )}
              <div class="tags">
                {project.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
              <details class="project-details">
                <summary>
                  Methods & contribution <span aria-hidden="true">+</span>
                </summary>
                <ul>
                  {project.highlights?.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
                {project.contribution && (
                  <p>
                    <strong>My contribution.</strong> {project.contribution}
                  </p>
                )}
              </details>
            </div>
            <div class="project-links">
              {project.href && <a href={project.href}>Paper ↗</a>}
              {project.repo && <a href={project.repo}>Code ↗</a>}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="research" class="content-section" aria-labelledby="research-title">
    <div class="section-heading">
      <h2 id="research-title"><span>02</span> Publications</h2><a
        class="section-meta"
        href={site.scholarUrl}>GOOGLE SCHOLAR ↗</a>
    </div>
    <ol class="publications">
      {
        site.publications?.map((paper) => (
          <li class="publication">
            <>
              <span class="publication-year">{paper.year}</span>
              <div>
                <>
                  <h3>
                    <a href={paper.href ?? site.scholarUrl}>{paper.title}</a>
                  </h3>
                  <p>
                    {paper.venue} <span> / </span> {paper.note}
                  </p>
                </>
              </div>
              <a
                class="paper-arrow"
                href={paper.href ?? site.scholarUrl}
                aria-label={"Read " + paper.title}
              >
                ↗
              </a>
            </>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="experience" class="content-section" aria-labelledby="experience-title">
    <div class="section-heading">
      <h2 id="experience-title"><span>03</span> Research & experience</h2><a
        class="section-meta"
        href="/resume.pdf">FULL CV ↗</a>
    </div>
    <div class="experience-list">
      {
        site.experience.map((entry) => (
          <article class="experience-entry">
            <>
              <div>
                <>
                  <p class="experience-period">{entry.period ?? entry.detail}</p>
                  <h3>{entry.organization}</h3>
                </>
              </div>
              <div>
                <p>{entry.description}</p>
                {entry.links && (
                  <div class="experience-links">
                    {entry.links.map((link) => (
                      <a href={link.href}>{link.label} ↗</a>
                    ))}
                  </div>
                )}
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section id="about" class="content-section" aria-labelledby="about-title">
    <div class="section-heading"><h2 id="about-title"><span>04</span> Methods & expertise</h2></div>
    <div class="about-section">
      <div class="about-copy">
        <p>
          I work on decision-making under constraints: modelling complex systems, learning from
          data, and evaluating whether proposed actions are feasible.
        </p><p>{site.interests}</p>{
          site.currentResearch.map((research) => (
            <aside class="research-note">
              <>
                <p class="eyebrow">{research.status}</p>
                <h3>{research.title}</h3>
                <p>{research.description}</p>
              </>
            </aside>
          ))
        }
      </div>
      <div id="skills" class="skills-list">
        {
          site.skills.map((skill) => (
            <div class="skill-row">
              <>
                <h3>{skill.group}</h3>
                <p>{skill.items.join(" / ")}</p>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section" aria-labelledby="contact-title">
    <div class="section-heading">
      <h2 id="contact-title"><span>05</span> Contact</h2><span class="section-meta"
        >LONDON, UK</span>
    </div>
    <a class="contact-email" href={"mailto:" + site.email}
      >{site.email}<span aria-hidden="true">↗</span></a
    >
    <p>Quantitative research & development · AI/ML research · Research engineering</p>
    <div class="contact-socials">
      {site.socials.map((social) => <a href={social.href}>{social.label} ↗</a>)}
    </div>
  </section>
</BaseLayout>
