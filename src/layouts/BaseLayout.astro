---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import { absoluteUrl } from "../utils/seo";

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage = "/profile.jpeg",
  canonicalPath = "/",
} = Astro.props as {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonicalPath?: string;
};

const finalOgTitle = ogTitle ?? title;
const finalOgDesc = ogDescription ?? description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={absoluteUrl(canonicalPath)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={finalOgTitle} />
    <meta property="og:description" content={finalOgDesc} />
    <meta property="og:url" content={absoluteUrl(canonicalPath)} />
    <meta property="og:image" content={absoluteUrl(ogImage)} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={finalOgTitle} />
    <meta name="twitter:description" content={finalOgDesc} />
    <meta name="twitter:image" content={absoluteUrl(ogImage)} />

    <title>{title}</title>
  </head>
  <body class="antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" class="shell" tabindex="-1">
      <slot />
    </main>
    <footer class="shell site-footer">
      <span>&copy; {new Date().getFullYear()} Javal Vyas</span>
      <span>AI · Optimization · Research engineering</span>
      <a href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </footer>
  </body>
</html>
